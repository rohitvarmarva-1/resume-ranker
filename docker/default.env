# Default Docker Environment Configuration
# This file is committed to git and provides safe defaults for docker-compose
# To use real credentials, create a .env file in the root directory

# Database Configuration (uses MongoDB Atlas - replace with your connection string)
MONGODB_URI=mongodb+srv://Vivek:VSweta%401234@vsproduct.bknr22r.mongodb.net/ats

# OpenAI API Configuration (optional - AI features disabled if not provided)
