# Email Configuration (optional - email notifications disabled if not provided)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Session Secret (auto-generated per deployment)
SESSION_SECRET=docker-default-secret-change-in-production-12345

# Node Environment
NODE_ENV=production
