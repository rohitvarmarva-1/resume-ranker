# Database Configuration
# Use MongoDB Atlas connection string or local MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ats?retryWrites=true&w=majority

# For local MongoDB (used by docker-compose):
# MONGODB_URI=mongodb://admin:admin123@mongo:27017/ats?authSource=admin

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Email Configuration (SMTP)
# For Gmail SMTP:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM=your_email@gmail.com

# For SendGrid SMTP:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_sendgrid_api_key
# SMTP_FROM=noreply@yourdomain.com

# Session Secret (change this to a random string)
SESSION_SECRET=your_super_secret_session_key_here

# Node Environment
NODE_ENV=production
