# ==========================================
# OPTIONAL ENVIRONMENT VARIABLES
# ==========================================
# 
# The application includes safe defaults in docker/default.env
# You only need to create this .env file if you want to:
#   1. Use your own MongoDB database
#   2. Enable AI features (requires OpenAI API key)
#   3. Enable email notifications (requires SMTP credentials)
#
# Simply run `docker-compose up -d` without this file for basic deployment!
#
# ==========================================

# Database Configuration (OPTIONAL)
# Default: MongoDB Atlas pre-configured in docker/default.env
# Uncomment to use your own database:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ats

# OpenAI API Configuration (OPTIONAL - Required for AI features)
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your_openai_api_key_here

# Email Configuration (OPTIONAL - Required for notifications)
# For Gmail (requires App Password with 2-step verification):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_character_app_password
# SMTP_FROM=your_email@gmail.com

# For SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_sendgrid_api_key
# SMTP_FROM=noreply@yourdomain.com

# Session Secret (OPTIONAL)
# Default: Auto-generated in docker/default.env
# Uncomment to use custom secret:
# SESSION_SECRET=your_super_secret_session_key_here

# Environment (OPTIONAL)
# Default: production
# NODE_ENV=production
